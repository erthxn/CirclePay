  "pill": {
    "height": 17,
    "gapBelowTile": 5,
    "widthRule": "max(tile + 8, 48)",
    "radius": 8.5,
    "fill": "yellow",
    "fontSize": {
      "tileGte44": 10,
      "tileGte36": 9.5,
      "else": 8.5
    },
    "fontWeight": 650,
    "textRule": "'$' + amount to 2 decimals, centered in the pill (x = pill center), ink on yellow, tabular figures",
    "preLandOpacity": 0.45,
    "preLandFill": "surfaceHigh",
    "preLandText": "muted"
  },
  "avatar": {
    "ringWidth": 2,
    "ringRule": "ring circle radius = size/2 - 1, stroke 2, drawn over the image",
    "fill": "surfaceHigh",
    "fallback": "generic silhouette: head circle r = 0.17*size at (x, y - 0.10*size); shoulders ellipse rx = 0.30*size, ry = 0.26*size at (x, y + 0.42*size); both clipped to the avatar circle; yellow at 85% opacity",
    "imageFit": "xMidYMid slice"
  },
  "arc": {
    "curve": "quadratic Bezier from the center point C to the member point P",
    "control": "ctrl = ((C.x+P.x)/2 + cos(a + PI/2) * off, (C.y+P.y)/2 + sin(a + PI/2) * off), where a is the member's angle from the center and off is the arc offset",
    "offsetOneRing": 28.8,
    "strokeWidthOneRing": 3.84,
    "strokeWidthTwoRing": 3.2,
    "strokeOpacity": 0.5,
    "lineCap": "round",
    "drawOrder": "arcs sit under the avatars so both ends are hidden"
  },
  "themes": {
    "default": "arc-yellow-black",
    "note": "Arc has ONE fixed palette. The studio's theme and line-style pickers never change it, and it never changes them.",
    "arc-yellow-black": {
      "background": "#0c0c0d",
      "backgroundGlow": "#161617",
      "surface": "#1c1c1e",
      "surfaceHigh": "#2c2c2e",
      "line": "#2a2a2c",
      "ringLine": "#1f1f21",
      "text": "#F5F5F7",
      "muted": "#A1A1A6",
      "yellow": "#FFD400",
      "yellowSoft": "#FFE14D",
      "ink": "#0A0A0A",
      "particleCore": "#FFF3A3",
      "glowStops": [
        [
          "0",
          "#FFD400",
          0.8
        ],
        [
          "0.5",
          "#FFD400",
          0.25
        ],
        [
          "1",
          "#FFD400",
          0
        ]
      ]
    }
  },
  "fonts": {
    "sans": "Inter, -apple-system, 'SF Pro Text', 'Segoe UI', Roboto, system-ui, Arial, sans-serif",
    "numeric": "font-variant-numeric: tabular-nums",
    "note": "One friendly sans for everything (Inter or SF Pro). Every number uses tabular figures so amounts do not jitter while they tick."
  },
  "mark": {
    "x": 14,
    "y": 10,
    "badgeRadius": 12,
    "badgeCenter": [
      26,
      22
    ],
    "viewBox": "190 370 1560 1260",
    "paths": [
      "M1400 795 H1106 A355 355 0 1 0 1085 1230 H1390 A615 615 0 1 1 1400 795 Z",
      "M997 855 h740 a76 76 0 0 1 0 152 h-740 a76 76 0 0 1 0 -152 Z",
      "M1242 1057 h352 a60 60 0 0 1 0 120 h-352 a60 60 0 0 1 0 -120 Z"
    ],
    "markWidth": 15,
    "title": {
      "text": "CirclePay",
      "x": 44,
      "y": 21,
      "size": 13,
      "weight": 650
    },
    "status": {
      "text": "last 7 days",
      "x": 44,
      "y": 33,
      "size": 9,
      "weight": 500
    },
    "layoutBox": {
      "x0": 8,
      "y0": 8,
      "x1": 104,
      "y1": 38
    }
  },
  "stamp": {
    "radiusRule": "clamp(0.2 * tile, 5, 9)",
    "offsetRule": "(+0.36 * tile, -0.36 * tile) from the member center",
    "fill": "yellow",
    "ringColor": "background",
    "ringWidth": 2,
    "check": "polyline in a unit box: (-0.45,0.02) (-0.12,0.35) (0.48,-0.32) times radius, stroke ink 1.6 round caps",
    "pop": "scale 0 -> 1 with easeOutBack over 0.35 s"
  },
  "particles": {
    "perArc": 3,
    "spacing": 0.38,
    "flight": 1,
    "path": "the arc's quadratic Bezier, parameter s in [0,1], linear in time, looping",
    "glow": {
      "radius": 6
    },
    "core": {
      "radius": 2
    },
    "trail": [
      {
        "dt": 0.03,
        "r": 1.8,
        "opacity": 0.6
      },
      {
        "dt": 0.06,
        "r": 1.4,
        "opacity": 0.4
      },
      {
        "dt": 0.09,
        "r": 1,
        "opacity": 0.2
      }
    ]
  },
  "timeline": {
    "loop": 11,
    "arcDraw": {
      "start": 0.1,
      "stagger": 0.04,
      "duration": 0.7,
      "easing": "easeOutCubic",
      "technique": "pathLength=1, dashoffset 1 -> 0"
    },
    "firstLaunch": 0.9,
    "launchStep": "min(0.34, 3.4 / n) seconds between members",
    "flight": 1,
    "tick": {
      "duration": 0.8,
      "easing": "easeOutCubic",
      "rule": "shown = round(cents * ease) / 100"
    },
    "stamp": {
      "delayAfterLand": 0.5,
      "duration": 0.35,
      "easing": "easeOutBack"
    },
    "landRipple": {
      "duration": 0.6,
      "radiusGrow": 10
    },
    "centerPulse": {
      "period": 1.6,
      "grow": 22,
      "duration": 1.6
    },
    "fadeOut": {
      "start": 9.6,
      "duration": 0.6
    },
    "finalFrame": 9,
    "finalFrameNote": "Static PNG fallback = frame at t = 9.0 with particles and pulses hidden: all amounts landed, every stamp shown, the total badge shown, total complete.",
    "easing": {
      "easeOutCubic": "1 - (1-x)^3",
      "easeOutBack": "1 + c3*(x-1)^3 + c1*(x-1)^2 with c1 = 1.70158, c3 = c1 + 1"
    },
    "paidBadge": {
      "delayAfterLastLand": 0.9,
      "duration": 0.35,
      "scaleFrom": 0,
      "easing": "easeOutBack"
    }
  },
  "sample": {
    "handle": "yourhandle",
    "date": "14/11/26",
    "totalCents": 2000,
    "amountRule": "weights w_i = n - i + 2; cents_i = floor(2000 * w_i / sum(w)); the leftover cents go one each to members 0,1,2.. in order",
    "memberHandles": "friend1 .. friendN"
  },
  "picker": {
    "arcIgnoresPickers": true,
    "note": "Selecting Arc renders only this spec. Theme and every other line style render through the legacy studio code and never touch Arc's output; switching away from Arc and back gives an identical Arc."
  },
  "rings": {
    "center": "owner center C",
    "radii": [
      92,
      160,
      228
    ],
    "strokeWidth": 1,
    "note": "Faint concentric rings behind the arcs, like ripples."
  },
