{
  "$schema": "CirclePay Arc card tokens",
  "name": "CirclePay Arc card",
  "version": "1.0.0",
  "license": "MIT",
  "canvas": {
    "width": 384,
    "height": 480,
    "aspect": "4:5",
    "stageHeight": 384,
    "stageNote": "The top 384x384 square is the arc stage (same geometry as the production Arc card). The bottom 384x96 is the receipt strip.",
    "cornerRadius": 28,
    "exportScale": 2.8125,
    "exportPx": [
      1080,
      1350
    ],
    "origin": "top-left, +x right, +y down, units are px of the 384x480 canvas"
  },
  "members": {
    "min": 3,
    "max": 15
  },
  "center": {
    "x": 192,
    "y": 192
  },
  "oneRing": {
    "maxMembers": 10,
    "angle": "a_i = (i / n) * 2*PI - PI/2, i = 0..n-1, clockwise from 12 o'clock",
    "bands": [
      {
        "maxN": 5,
        "radiusPct": 30,
        "tile": 50,
        "center": 58
      },
      {
        "maxN": 7,
        "radiusPct": 32,
        "tile": 44,
        "center": 52
      },
      {
        "maxN": 10,
        "radiusPct": 34,
        "tile": 38,
        "center": 52
      }
    ],
    "radiusRule": "R = radiusPct * 384 / 100",
    "position": "x_i = 192 + cos(a_i) * R, y_i = 192 + sin(a_i) * R"
  },
  "twoRing": {
    "appliesFrom": 11,
    "center": {
      "x": 192,
      "y": 182
    },
    "centerSize": 46,
    "arcOffsetDefault": 15,
    "innerCount": "k = ceil(n / 3)",
    "outerCount": "m = n - k",
