        "radiusPct": 34,
        "tile": 38,
        "center": 52
      }
    ],
    "radiusRule": "R = radiusPct * 384 / 100",
    "position": "x_i = 192 + cos(a_i) * R, y_i = 192 + sin(a_i) * R"
  },
