  "pill": {
    "height": 17,
    "gapBelowTile": 5,
    "widthRule": "max(tile + 8, 48)",
    "radius": 8.5,
    "coinRadius": {
      "tileGte44": 6.5,
      "tileGte36": 6,
      "else": 5.5
    },
    "coinInset": 8.5,
    "fontSize": {
      "tileGte44": 10,
      "tileGte36": 9.5,
      "else": 8.5
    },
    "fontWeight": 700,
    "textRule": "amount to 2 decimals without a dollar sign (the coin carries the $), centered in the space right of the coin: cx = pillLeft + 17 + (pillWidth - 21) / 2",
    "preLandOpacity": 0.55
  },
  "avatar": {
    "ringWidth": 2,
    "ringRule": "ring circle radius = size/2 - 1, stroke 2, drawn over the image",
    "fallback": "generic silhouette: head circle r = 0.17*size at (x, y - 0.10*size); shoulders ellipse rx = 0.30*size, ry = 0.26*size at (x, y + 0.42*size); both clipped to the avatar circle",
    "imageFit": "xMidYMid slice"
  },
  "arc": {
    "curve": "quadratic Bezier from the center point C to the member point P",
    "control": "ctrl = ((C.x+P.x)/2 + cos(a + PI/2) * off, (C.y+P.y)/2 + sin(a + PI/2) * off), where a is the member's angle from the center and off is the arc offset",
    "offsetOneRing": 28.8,
    "strokeWidthOneRing": 3.84,
    "strokeWidthTwoRing": 3.2,
    "strokeOpacity": 0.55,
    "lineCap": "butt",
    "drawOrder": "arcs sit under the avatars so both ends are hidden"
  },
  "themes": {
    "default": "arc-yellow-black",
    "note": "Arc has ONE fixed palette. The studio's theme and line-style pickers never change it, and it never changes them.",
    "arc-yellow-black": {
      "background": "#0a0a0a",
      "yellow": "#FFD400",
      "yellowSoft": "#FFE14D",
      "ink": "#0a0a0a",
      "avatarBg": "#1a1a1a",
      "particleCore": "#FFF6B8",
      "glowStops": [
        [
          "0",
          "#FFD400",
          0.95
        ],
        [
          "0.45",
          "#FFD400",
          0.35
        ],
        [
          "1",
          "#FFD400",
          0
        ]
      ]
    }
  },
  "fonts": {
    "mono": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "sans": "'Bricolage Grotesque', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
    "note": "Mono is used for every number and for the handle and date. Sans is only used for the brand word in the top-left mark."
  },
  "mark": {
    "x": 14,
    "y": 12,
    "width": 24,
    "viewBox": "190 370 1560 1260",
    "paths": [
      "M1400 795 H1106 A355 355 0 1 0 1085 1230 H1390 A615 615 0 1 1 1400 795 Z",
      "M997 855 h740 a76 76 0 0 1 0 152 h-740 a76 76 0 0 1 0 -152 Z",
      "M1242 1057 h352 a60 60 0 0 1 0 120 h-352 a60 60 0 0 1 0 -120 Z"
    ],
    "word": {
      "text": "circlepay",
      "x": 44,
      "y": 25,
      "size": 9,
      "opacity": 0.85
    },
    "layoutBox": {
      "x0": 8,
      "y0": 8,
      "x1": 100,
      "y1": 34
    }
  },
  "guilloche": {
    "center": {
      "x": 192,
      "y": 192
    },
    "formula": "hypotrochoid: x = (R-r)*cos(t) + d*cos((R-r)/r * t), y = (R-r)*sin(t) - d*sin((R-r)/r * t), t = 0 .. 2*PI*r in steps of PI/24; then scale",
    "rosettes": [
      {
        "R": 96,
        "r": 29,
        "d": 70,
        "scale": 1.5,
        "strokeWidth": 0.5,
        "opacity": 0.1
      },
      {
        "R": 100,
        "r": 43,
        "d": 60,
        "scale": 1.7,
        "strokeWidth": 0.5,
        "opacity": 0.07
      }
    ],
    "border": {
      "inset": 8,
      "amplitude": 2.5,
      "wavelength": 14,
      "strokeWidth": 0.6,
      "opacity": 0.22,
      "phases": [
        0,
        3.14159265
      ],
      "run": "left edge bottom to top, top edge left to right, right edge top to bottom; stops at y = 470; no bottom edge"
    }
  },
