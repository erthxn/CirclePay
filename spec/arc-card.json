      "format": "@ + lowercase handle"
    },
    "date": {
      "x": 360,
      "y": 452,
      "size": 15,
      "weight": 700,
      "anchor": "end",
      "format": "DD/MM/YY"
    },
    "tagline": {
      "text": "reward your x circle · last 7 days",
      "x": 24,
      "y": 466,
      "size": 7,
      "opacity": 0.65
    },
    "paidStamp": {
      "x": 190,
      "y": 414,
      "w": 56,
      "h": 21,
      "rotateDeg": -9,
      "text": "PAID",
      "size": 11,
      "letterSpacing": 2,
      "strokeWidth": 1.5,
      "opacity": 0.85
    }
  },
  "stamp": {
    "radiusRule": "clamp(0.2 * tile, 5, 9)",
    "offsetRule": "(+0.36 * tile, -0.36 * tile) from the member center",
    "fill": "yellow",
    "strokeInk": 1.5,
    "check": "polyline in a unit box: (-0.45,0.02) (-0.12,0.35) (0.48,-0.32) times radius, stroke ink 1.6 round caps",
    "pop": "scale 0 -> 1 with easeOutBack over 0.35 s"
  },
  "particles": {
    "perArc": 3,
    "spacing": 0.38,
    "flight": 1,
    "path": "the arc's quadratic Bezier, parameter s in [0,1], linear in time, looping",
    "glow": {
      "radius": 7
    },
    "core": {
      "radius": 2.2
    },
    "trail": [
      {
        "dt": 0.03,
        "r": 1.8,
        "opacity": 0.6
      },
      {
        "dt": 0.06,
        "r": 1.4,
        "opacity": 0.4
      },
      {
        "dt": 0.09,
        "r": 1,
        "opacity": 0.2
      }
    ]
  },
  "timeline": {
    "loop": 11,
    "arcDraw": {
      "start": 0.1,
      "stagger": 0.04,
      "duration": 0.7,
      "easing": "easeOutCubic",
      "technique": "pathLength=1, dashoffset 1 -> 0"
    },
    "firstLaunch": 0.9,
    "launchStep": "min(0.34, 3.4 / n) seconds between members",
    "flight": 1,
    "tick": {
      "duration": 0.8,
      "easing": "easeOutCubic",
      "rule": "shown = round(cents * ease) / 100"
    },
    "stamp": {
      "delayAfterLand": 0.5,
      "duration": 0.35,
      "easing": "easeOutBack"
    },
    "landRipple": {
      "duration": 0.6,
      "radiusGrow": 10
    },
    "centerPulse": {
      "period": 1.6,
      "grow": 22,
      "duration": 1.6
    },
    "paidReceipt": {
      "delayAfterLastLand": 0.9,
      "duration": 0.4,
      "scaleFrom": 1.5,
      "easing": "easeOutCubic"
    },
    "fadeOut": {
      "start": 9.6,
      "duration": 0.6
    },
    "finalFrame": 9,
    "finalFrameNote": "Static PNG fallback = frame at t = 9.0 with particles and pulses hidden: all amounts landed, every stamp shown, PAID stamp shown, total complete.",
    "easing": {
      "easeOutCubic": "1 - (1-x)^3",
      "easeOutBack": "1 + c3*(x-1)^3 + c1*(x-1)^2 with c1 = 1.70158, c3 = c1 + 1"
    }
  },
  "sample": {
    "handle": "yourhandle",
    "date": "14/11/26",
    "totalCents": 2000,
    "amountRule": "weights w_i = n - i + 2; cents_i = floor(2000 * w_i / sum(w)); the leftover cents go one each to members 0,1,2.. in order",
    "memberHandles": "friend1 .. friendN"
  },
  "picker": {
    "arcIgnoresPickers": true,
    "note": "Selecting Arc renders only this spec. Theme and every other line style render through the legacy studio code and never touch Arc's output; switching away from Arc and back gives an identical Arc."
  }
}
